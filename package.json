{
  "name": "ribbon",
  "version": "0.1.0",
  "private": true,
  "description": "Production-grade Next.js dashboard boilerplate: custom auth, RBAC with role inheritance, OAuth2 provider + SSO client, audit log, i18n, theming, and a polished shadcn/GSAP UI.",
  "license": "Apache-2.0",
  "author": "redstone-md",
  "homepage": "https://github.com/redstone-md/ribbon#readme",
  "repository": {
    "type": "git",
    "url": "https://github.com/redstone-md/ribbon.git"
  },
  "bugs": {
    "url": "https://github.com/redstone-md/ribbon/issues"
  },
  "keywords": [
    "nextjs",
    "boilerplate",
    "rbac",
    "oauth2",
    "authentication",
    "dashboard",
    "shadcn",
    "prisma",
    "mongodb",
    "i18n"
  ],
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "biome check",
    "format": "biome format --write",
    "db:generate": "prisma generate",
    "db:push": "prisma db push",
    "db:seed": "tsx prisma/seed.ts",
    "db:setup": "prisma db push && tsx prisma/seed.ts",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@bprogress/next": "^3.2.12",
    "@hugeicons/core-free-icons": "^4.2.0",
    "@hugeicons/react": "^1.1.6",
    "@prisma/client": "^6.19.3",
    "@tanstack/react-query": "^5.100.14",
    "@tanstack/react-query-devtools": "^5.100.14",
    "bcryptjs": "^3.0.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "lenis": "^1.3.23",
    "next": "16.2.7",
    "next-intl": "^4.13.0",
    "next-themes": "^0.4.6",
    "pino": "^10.3.1",
    "radix-ui": "^1.4.3",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.6.0",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.4.3",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@biomejs/biome": "2.2.0",
