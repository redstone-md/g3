# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# go / g3 backend
/g3
/g3.exe
# embedded frontend bundle (built by `make build`); keep the placeholder
/server/internal/httpd/dist/*
!/server/internal/httpd/dist/.gitkeep
/g3-data/
*.db
*.db-shm
*.db-wal

# Local tooling scratch (aislop scans, continuum index)
.aislop/
.continuum/
