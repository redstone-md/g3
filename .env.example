# --- Database (MongoDB, replica set required for Prisma transactions) ---
DATABASE_URL="mongodb+srv://user:pass@cluster.mongodb.net/ribbon?retryWrites=true&w=majority"

# --- First-run seed (optional) ---
# Admin email for the seeded account. Password is random + printed once.
ADMIN_EMAIL="admin@ribbon.local"

# --- "Sign in with SSO" (OAuth2 client) ---
# Point a child app at the main Ribbon (the OAuth provider). Leave blank to
# hide the SSO button. Register this app under the provider's OAuth Clients
# and copy the issued client id/secret here. Redirect URI must match exactly.
SSO_ISSUER="https://main-app.example.com"
SSO_CLIENT_ID=""
SSO_CLIENT_SECRET=""
SSO_REDIRECT_URI="http://localhost:3000/api/auth/sso/callback"
SSO_SCOPES="openid profile email"
