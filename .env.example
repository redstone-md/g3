# G3 server configuration. Copy to .env (gitignored) and adjust.
# The Go backend reads these at startup; the frontend is static and needs none.

# --- HTTP ---
# Panel + S3 API listen address.
G3_ADDR=":8787"

# --- Data ---
# Directory for the embedded SQLite metadata DB (created on first run).
G3_DATA_DIR="./g3-data"

# --- First-run admin seed ---
# Seeded once if no users exist. Change the password immediately after.
G3_ADMIN_EMAIL="admin@g3.local"
G3_ADMIN_PASSWORD="change-me-now"

# --- Secrets ---
# 32-byte base64 key used to encrypt stored Google refresh tokens at rest.
# Generate: openssl rand -base64 32
G3_ENCRYPTION_KEY=""

# --- Google Drive OAuth (added in Phase 3) ---
# OAuth client for linking Google accounts as Drive storage backends.
# Create at https://console.cloud.google.com (Drive API enabled).
G3_GOOGLE_CLIENT_ID=""
G3_GOOGLE_CLIENT_SECRET=""
G3_GOOGLE_REDIRECT_URI="http://localhost:8787/api/accounts/callback"
